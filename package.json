{
  "name": "capsule-zero",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "check:feature-memory": "node scripts/check-feature-memory.mjs",
    "check:api-contract": "node scripts/check-api-contract.mjs && node scripts/generate-api-clients.mjs --check",
    "check:repo": "node scripts/check-repo-baseline.mjs",
    "check:runtime-env": "node scripts/check-runtime-env.mjs",
    "check:runtime-tooling": "node scripts/check-runtime-tooling.mjs",
    "check:supabase-local": "supabase db reset && supabase test db",
    "generate:api": "node scripts/generate-api-clients.mjs",
    "spike:photoroom": "node scripts/photoroom-spike.mjs",
    "lint": "npm --prefix app run lint",
    "format": "prettier --write .",
    "typecheck": "npm --prefix app run typecheck",
    "build": "npm --prefix app run build",
    "test": "npm --prefix app run test --if-present",
    "prepare": "husky",
    "precommit": "npm run check:feature-memory -- --worktree && lint-staged",
    "preflight": "npm run check:feature-memory -- --worktree && npm run check:repo && npm run check:api-contract && npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "yaml": "^2.8.3"
  }
}
