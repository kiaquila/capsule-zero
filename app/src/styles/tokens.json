{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Capsule Zero Design Tokens",
    "version": "1.0.0",
    "description": "Glass morphism design system — achromatic palette, wallpaper background, 8px grid"
  },

  "color": {
    "black": { "value": "#0A0A0A" },
    "white": { "value": "#FAFAFA" },
    "gray": {
      "50":  { "value": "#F5F5F5" },
      "100": { "value": "#EBEBEB" },
      "200": { "value": "#D6D6D6" },
      "300": { "value": "#C2C2C2" },
      "400": { "value": "#ADADAD" },
      "500": { "value": "#999999" },
      "600": { "value": "#757575" },
      "700": { "value": "#525252" },
      "800": { "value": "#2E2E2E" },
      "900": { "value": "#1A1A1A" }
    },
    "error": { "value": "#FFD600" },
    "favorite": { "value": "rgba(220,30,50,.90)" },
    "favoriteBorder": { "value": "rgba(255,60,80,.70)" }
  },

  "overlay": {
    "start": { "value": "rgba(0,0,0,.58)" },
    "mid":   { "value": "rgba(0,0,0,.40)" },
    "end":   { "value": "rgba(0,0,0,.68)" }
  },

  "glass": {
    "panel": {
      "bg":        { "value": "rgba(255,255,255,0.22)" },
      "blur":      { "value": "40px" },
      "border":    { "value": "rgba(255,255,255,.58)" },
      "highlight": { "value": "rgba(255,255,255,.72)" },
      "shadow":    { "value": "0 8px 32px rgba(0,0,0,.22)" }
    },
    "nav": {
      "bg":     { "value": "rgba(255,255,255,0.13)" },
      "blur":   { "value": "44px" },
      "border": { "value": "rgba(255,255,255,.20)" }
    },
    "sheet": {
      "bg":     { "value": "rgba(255,255,255,0.22)" },
      "blur":   { "value": "44px" },
      "border": { "value": "rgba(255,255,255,.58)" },
      "shadow": { "value": "0 -8px 32px rgba(0,0,0,.22)" }
    },
    "popup": {
      "bg":   { "value": "rgba(255,255,255,0.28)" },
      "blur": { "value": "32px" }
    }
  },

  "text": {
    "primary":     { "value": "rgba(255,255,255,.95)" },
    "secondary":   { "value": "rgba(255,255,255,.70)" },
    "placeholder": { "value": "rgba(255,255,255,.38)" }
  },

  "button": {
    "primary": {
      "bg":     { "value": "rgba(255,255,255,.36)" },
      "border": { "value": "rgba(255,255,255,.52)" }
    },
    "ghost": {
      "bg":     { "value": "rgba(255,255,255,.10)" },
      "border": { "value": "rgba(255,255,255,.22)" }
    },
    "social": {
      "bg": { "value": "rgba(255,255,255,.28)" }
    },
    "danger": {
      "bg":     { "value": "rgba(255,80,60,.10)" },
      "border": { "value": "rgba(255,80,60,.25)" },
      "color":  { "value": "rgba(255,120,100,.85)" }
    }
  },

  "interactive": {
    "card": {
      "bg":          { "value": "rgba(255,255,255,.10)" },
      "border":      { "value": "rgba(255,255,255,.22)" },
      "hoverBg":     { "value": "rgba(255,255,255,.18)" },
      "hoverBorder": { "value": "rgba(255,255,255,.38)" }
    },
    "input": {
      "bg":          { "value": "rgba(255,255,255,.08)" },
      "border":      { "value": "rgba(255,255,255,.18)" },
      "focusBg":     { "value": "rgba(255,255,255,.12)" },
      "focusBorder": { "value": "rgba(255,255,255,.36)" }
    },
    "toggle": {
      "bg":        { "value": "rgba(255,255,255,.12)" },
      "border":    { "value": "rgba(255,255,255,.22)" },
      "onBg":      { "value": "rgba(255,255,255,.32)" },
      "onBorder":  { "value": "rgba(255,255,255,.48)" },
      "knob":      { "value": "rgba(255,255,255,.60)" },
      "knobOn":    { "value": "rgba(255,255,255,.95)" }
    },
    "nav": {
      "activeIndicator": { "value": "rgba(255,255,255,.65)" },
      "activeBg":        { "value": "rgba(255,255,255,.10)" }
    },
    "tab": {
      "activeBg":     { "value": "rgba(255,255,255,.22)" },
      "activeBorder": { "value": "rgba(255,255,255,.40)" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans":    { "value": "'Helvetica Neue', Arial, sans-serif" },
      "mono":    { "value": "'JetBrains Mono', 'Fira Code', monospace" }
    },
    "fontSize": {
      "2xs":  { "value": "9px",  "description": "bnav label, badge" },
      "xs":   { "value": "10.5px", "description": "label, caption" },
      "sm":   { "value": "13px", "description": "nav item, body small" },
      "base": { "value": "15px", "description": "body" },
      "lg":   { "value": "18px", "description": "section title" },
      "xl":   { "value": "24px", "description": "page subtitle" },
      "2xl":  { "value": "30px", "description": "stat number" },
      "3xl":  { "value": "36px", "description": "page title" },
      "4xl":  { "value": "64px", "description": "hero OPR" },
      "hero": { "value": "42px", "description": "landing hero" }
    },
    "letterSpacing": {
      "tight":   { "value": "-0.035em", "description": "large numbers" },
      "normal":  { "value": "0.01em",   "description": "body" },
      "wide":    { "value": "0.06em",   "description": "nav labels" },
      "wider":   { "value": "0.11em",   "description": "section labels" },
      "widest":  { "value": "0.26em",   "description": "logo" }
    }
  },

  "spacing": {
    "unit": { "value": "8px", "description": "Base grid unit" },
    "scale": {
      "0":   { "value": "0" },
      "0.5": { "value": "4px" },
      "1":   { "value": "8px" },
      "1.5": { "value": "12px" },
      "2":   { "value": "16px" },
      "2.5": { "value": "20px" },
      "3":   { "value": "24px" },
      "3.5": { "value": "28px" },
      "4":   { "value": "32px" },
      "5":   { "value": "40px" },
      "6":   { "value": "48px" },
      "8":   { "value": "64px" },
      "10":  { "value": "80px" },
      "12":  { "value": "96px" },
      "16":  { "value": "128px" }
    }
  },

  "radius": {
    "xs":     { "value": "6px" },
    "sm":     { "value": "8px" },
    "md":     { "value": "14px" },
    "lg":     { "value": "20px" },
    "pill":   { "value": "50px" },
    "circle": { "value": "50%" }
  },

  "transition": {
    "fast":   { "value": "140ms ease" },
    "normal": { "value": "250ms ease" },
    "slow":   { "value": "400ms ease" },
    "spring": { "value": "300ms cubic-bezier(.32,.72,.24,1)" }
  },

  "zIndex": {
    "bg":       { "value": -2 },
    "overlay":  { "value": -1 },
    "base":     { "value": 0 },
    "raised":   { "value": 10 },
    "nav":      { "value": 50 },
    "sheet":    { "value": 60 },
    "modal":    { "value": 70 },
    "dropdown": { "value": 100 },
    "toast":    { "value": 300 },
    "tooltip":  { "value": 400 }
  },

  "layout": {
    "sidebarWidth": { "value": "248px" },
    "breakpoint": {
      "tablet":  { "value": "768px" },
      "desktop": { "value": "1024px" }
    }
  }
}
