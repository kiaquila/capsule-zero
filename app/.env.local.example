# Capsule Zero web/server environment template.
# Copy to app/.env.local for local development. Keep real values out of git.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only. Never expose this key in Client Components or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Auth/mobile redirect contract.
MOBILE_DEEP_LINK_SCHEME=capsulezero

# Background removal.
PHOTOROOM_API_KEY=replace-with-photoroom-api-key
PHOTOROOM_API_URL=https://sdk.photoroom.com/v1/segment
REMOVE_BG_API_KEY=

# Lava.top web coin purchases.
LAVA_API_URL=https://replace-with-lava-api-base-url
LAVA_API_KEY=replace-with-lava-api-key
LAVA_WEBHOOK_API_KEY=replace-with-webhook-api-key-max-80-chars
LAVA_COINS_5_PRODUCT_ID=replace-with-lava-product-id
LAVA_COINS_15_PRODUCT_ID=replace-with-lava-product-id
LAVA_COINS_30_PRODUCT_ID=replace-with-lava-product-id

# Catalog embeddings. Keep provider-specific secrets server-only.
EMBEDDING_PROVIDER=disabled
