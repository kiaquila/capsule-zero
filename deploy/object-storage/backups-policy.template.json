{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBackupWriterPut",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::capsulezero-prod-backups/postgres/*"
    },
    {
      "Sid": "DenyBackupWriterObjectReadsDeletesAndControls",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAcl",
        "s3:GetObjectVersionAcl",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": "arn:aws:s3:::capsulezero-prod-backups/postgres/*"
    },
    {
      "Sid": "DenyBackupWriterBucketReads",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::capsulezero-prod-backups"
    },
    {
      "Sid": "DenyBackupPutWithCannedAcl",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::capsulezero-prod-backups/postgres/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": [
            "public-read",
            "public-read-write",
            "authenticated-read",
            "aws-exec-read",
            "bucket-owner-read",
            "bucket-owner-full-control",
            "log-delivery-write"
          ]
        }
      }
    },
    {
      "Sid": "DenyBackupPutWithGrantRead",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::capsulezero-prod-backups/postgres/*",
      "Condition": {
        "StringLike": {
          "s3:x-amz-grant-read": ["*uri=*", "*id=*", "*emailAddress=*"]
        }
      }
    },
    {
      "Sid": "DenyBackupPutWithGrantReadAcl",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::capsulezero-prod-backups/postgres/*",
      "Condition": {
        "StringLike": {
          "s3:x-amz-grant-read-acp": ["*uri=*", "*id=*", "*emailAddress=*"]
        }
      }
    },
    {
      "Sid": "DenyBackupPutWithGrantWriteAcl",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::capsulezero-prod-backups/postgres/*",
      "Condition": {
        "StringLike": {
          "s3:x-amz-grant-write-acp": ["*uri=*", "*id=*", "*emailAddress=*"]
        }
      }
    },
    {
      "Sid": "DenyBackupPutWithGrantFullControl",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam:::user/p15302925:__BACKUP_ACCESS_KEY_ID__"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::capsulezero-prod-backups/postgres/*",
      "Condition": {
        "StringLike": {
          "s3:x-amz-grant-full-control": ["*uri=*", "*id=*", "*emailAddress=*"]
        }
      }
    }
  ]
}
