# Copy to `deploy/runtime.env` on the production VM.

NEXT_PUBLIC_APP_URL=https://capsule-zero.example
CAPSULE_PROVIDER_MODE=mock

# Required by the runtime env contract. Replace with production provider values
# only after the corresponding integration gate is approved.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-production-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-supabase-service-role-key

MOBILE_DEEP_LINK_SCHEME=capsulezero

# External providers remain mocked until their integration gates open.
PHOTOROOM_API_KEY=mock-production-photoroom-key
PHOTOROOM_API_URL=https://sdk.photoroom.com/v1/segment
REMOVE_BG_API_KEY=
LAVA_API_URL=https://capsule-zero.example/api/mock/lava
LAVA_API_KEY=mock-production-lava-key
LAVA_WEBHOOK_API_KEY=mock-production-webhook-key
LAVA_COINS_5_PRODUCT_ID=mock-lava-coins-5
LAVA_COINS_15_PRODUCT_ID=mock-lava-coins-15
LAVA_COINS_30_PRODUCT_ID=mock-lava-coins-30
EMBEDDING_PROVIDER=disabled
