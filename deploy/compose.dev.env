# Capsule Zero — LOCAL DEV env file (throwaway credentials, never the droplet).
#
# The base docker-compose.yml deliberately fails fast on missing production
# secrets (`${VAR:?...}`), which is evaluated when the base file loads — an
# override file's default cannot rescue it. So the documented local-dev command
# supplies this env file:
#
#   docker compose --env-file deploy/compose.dev.env \
#     -f docker-compose.yml -f docker-compose.dev.yml up --build
#
# docker-compose.dev.yml then layers the dev-only behaviour (MailHog courier,
# Kratos --dev, capsulezero.local URLs, loopback port binds) on top.

# --- Postgres (dev) --------------------------------------------------------
POSTGRES_USER=capsule
POSTGRES_PASSWORD=capsule-dev-password
POSTGRES_DB=capsule_zero
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=kratos-dev-password
KRATOS_DB_NAME=kratos

# --- Go API (dev) ----------------------------------------------------------
API_DATABASE_URL=postgres://capsule:capsule-dev-password@postgres:5432/capsule_zero?sslmode=disable

# --- Kratos (dev) ----------------------------------------------------------
# docker-compose.dev.yml overrides the courier + public URL for MailHog/loopback;
# these satisfy the base-file interpolation and stay consistent with that override.
KRATOS_DSN=postgres://kratos:kratos-dev-password@postgres:5432/kratos?sslmode=disable
KRATOS_SMTP_CONNECTION_URI=smtp://mailhog:1025/?disable_starttls=true
KRATOS_PUBLIC_BASE_URL=http://127.0.0.1:4433/
# Kratos cookie secret (any strong string) + 32-char xchacha20-poly1305 cipher.
SECRETS_COOKIE_0=dev-only-kratos-cookie-secret-change-me-32
SECRETS_CIPHER_0=dev0only0kratos0cipher0secret032

# --- Web (dev) -------------------------------------------------------------
APP_BASE_URL=https://capsulezero.local
SESSION_SIGNING_SECRET=dev-only-session-signing-secret-change-me
