# Capsule Zero — LOCAL DEV env file (throwaway credentials, never the droplet).
#
# The base docker-compose.yml deliberately fails fast on missing production
# secrets (`${VAR:?...}`), which is evaluated when the base file loads — an
# override file's default cannot rescue it. So the documented local-dev command
# supplies this env file:
#
#   docker compose --env-file deploy/compose.dev.env \
#     -f docker-compose.yml -f docker-compose.dev.yml up --build
#
# docker-compose.dev.yml then layers the dev-only behaviour (MailHog courier,
# Kratos --dev, capsulezero.local URLs, loopback port binds) on top.

# --- Postgres (dev) --------------------------------------------------------
POSTGRES_USER=capsule
POSTGRES_PASSWORD=capsule-dev-password
POSTGRES_DB=capsule_zero
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=kratos-dev-password
KRATOS_DB_NAME=kratos
# Least-privilege app role (spec 034) — provisioned on first init of an empty
# volume. A pre-034 local volume lacks the role: `docker compose down -v` and
# re-up, or create it manually per docs_capsule_zero/project/devops/prod-cd-pipeline.md.
APP_DB_USER=capsule_app
APP_DB_PASSWORD=capsule-app-dev-password

# --- Go API (dev) ----------------------------------------------------------
# Dev exercises the same least-privilege role production runs on (spec 034).
API_DATABASE_URL=postgres://capsule_app:capsule-app-dev-password@postgres:5432/capsule_zero?sslmode=disable

# --- Object Storage (dev, disabled placeholders) ---------------------------
# These non-secret values satisfy the production-shape compose/config contract;
# they grant no storage access. Upload routes stay closed and /api/health reports
# storage=error until an ignored local env copy supplies dedicated non-production
# Hetzner credentials. Never place production credentials in local development.
OBJECT_STORAGE_ENDPOINT=https://hel1.your-objectstorage.com
OBJECT_STORAGE_REGION=hel1
OBJECT_STORAGE_ACCESS_KEY_ID=local-disabled-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-disabled-secret-key
OBJECT_STORAGE_PRIVATE_BUCKET=capsulezero-local-disabled-private
OBJECT_STORAGE_PUBLIC_BUCKET=capsulezero-local-disabled-public
OBJECT_STORAGE_PUBLIC_BASE_URL=https://capsulezero-local-disabled-public.hel1.your-objectstorage.com
OBJECT_STORAGE_UPLOADS_ENABLED=false

# --- Kratos (dev) ----------------------------------------------------------
# docker-compose.dev.yml overrides the courier + public URL for MailHog/loopback;
# these satisfy the base-file interpolation and stay consistent with that override.
KRATOS_DSN=postgres://kratos:kratos-dev-password@postgres:5432/kratos?sslmode=disable
KRATOS_SMTP_CONNECTION_URI=smtp://mailhog:1025/?disable_starttls=true
KRATOS_PUBLIC_BASE_URL=http://127.0.0.1:4433/
# Kratos cookie secret (any strong string) + 32-char xchacha20-poly1305 cipher.
SECRETS_COOKIE_0=dev-only-kratos-cookie-secret-change-me-32
SECRETS_CIPHER_0=dev0only0kratos0cipher0secret032
# Google sign-in (spec 037) stays OFF in dev by default; to test the real
# dance locally, mirror the KRATOS_OIDC_*/AUTH_GOOGLE_ENABLED trio from
# deploy/compose.env.example with a dev OAuth client.

# --- Web (dev) -------------------------------------------------------------
APP_BASE_URL=https://capsulezero.local
SESSION_SIGNING_SECRET=dev-only-session-signing-secret-change-me
