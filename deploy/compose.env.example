# Copy to `/srv/capsule-zero/repo/.env` on the droplet before running Docker
# Compose. Values below are placeholders for config validation only; rotate
# every secret before staging or production startup.

COMPOSE_PROJECT_NAME=capsule-zero

# Public hosts
APP_HOST=capsulezero.app
APP_BASE_URL=https://capsulezero.app
GRAFANA_HOST=grafana.capsulezero.app
GRAFANA_ROOT_URL=https://grafana.capsulezero.app

# Traefik / Let's Encrypt / Cloudflare DNS-01
ACME_EMAIL=ops@capsulezero.app
CF_DNS_API_TOKEN=

# Postgres / PgBouncer
POSTGRES_USER=capsule_zero
POSTGRES_PASSWORD=PLACEHOLDER_ROTATE_ME
POSTGRES_DB=capsule_zero
POSTGRES_URL=

# Ory Kratos
KRATOS_DSN=postgres://kratos:kratos@postgres:5432/kratos?sslmode=disable
KRATOS_SECRETS_COOKIE=PLACEHOLDER_ROTATE_ME
KRATOS_SECRETS_CIPHER=PLACEHOLDER_ROTATE_ME_32CHARSLONG
KRATOS_COURIER_SMTP_URI=
KRATOS_PUBLIC_URL=https://capsulezero.app/self-service

# Redis
REDIS_URL=redis://redis:6379

# DigitalOcean Spaces / imgproxy
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=capsulezero
SPACES_ACCESS_KEY=PLACEHOLDER
SPACES_SECRET_KEY=PLACEHOLDER
SPACES_CDN_BASE=https://capsulezero.fra1.cdn.digitaloceanspaces.com
IMGPROXY_KEY=
IMGPROXY_SALT=

# Resend / transactional email
RESEND_API_KEY=
RESEND_FROM=no-reply@capsulezero.app

# Grafana
GRAFANA_ADMIN_PASSWORD=PLACEHOLDER_ROTATE_ME

# App runtime
MOBILE_DEEP_LINK_SCHEME=capsulezero
EMBEDDING_PROVIDER=pgvector
OTEL_EXPORTER_OTLP_ENDPOINT=

# Lava.top is stubbed in v0.1; keep IDs blank until live billing opens.
LAVA_API_URL=https://gate.lava.top/api/v3/invoice
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_COINS_5_PRODUCT_ID=
LAVA_COINS_15_PRODUCT_ID=
LAVA_COINS_30_PRODUCT_ID=
