# Capsule Zero production compose env contract.
#
# Copy to `/opt/capsule-zero/.env` on the droplet with mode 600 before running
# Docker Compose. Values below are safe placeholders; real production values
# live only on the droplet and in provider dashboards.
#
# Redis/imgproxy/backup-automation variables are added only when those deferred
# runtime phases land. Kratos, Resend SMTP, and Object Storage are active here.

COMPOSE_PROJECT_NAME=capsule-zero

# Web image build args
NODE_VERSION=22-bookworm-slim
CAPSULE_WEB_IMAGE=capsule-zero-web:local

# Public host config
APP_HOST=capsulezero.app
APP_BASE_URL=https://capsulezero.app

# nginx bind — set to 127.0.0.1 if Cloudflare Tunnel is fronting the droplet.
NGINX_HOST_BIND=0.0.0.0

# Override only if Let's Encrypt material lives outside the host default.
# LETSENCRYPT_HOST_DIR=/etc/letsencrypt

# Host path used by certbot webroot renewals and mounted read-only into nginx.
# CERTBOT_WEBROOT_HOST_DIR=/var/www/certbot

# --- Postgres data tier ---------------------------------------------------
# Plain postgres:16 (pgvector deferred to the semantic-search slice). The init
# script in infra/postgres/ provisions a separate `kratos` role + database and
# (spec 034) a least-privilege `capsule_app` role that owns the app database —
# the API's DSN uses that role, never the image-managed superuser. These
# placeholders are safe for a fresh local volume; the droplet uses real secrets.
POSTGRES_USER=capsule
POSTGRES_PASSWORD=placeholder-postgres-password
POSTGRES_DB=capsule_zero
# Bind Postgres to loopback on the droplet; nothing external connects directly.
POSTGRES_HOST_BIND=127.0.0.1
# Kratos role/database provisioned by infra/postgres/00-kratos-db.sh on first init.
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=placeholder-kratos-db-password
KRATOS_DB_NAME=kratos
# Least-privilege app role (spec 034), provisioned on first init of an empty
# volume only — a populated volume (like prod) needs the one-time rollout in
# docs_capsule_zero/project/devops/prod-cd-pipeline.md instead.
APP_DB_USER=capsule_app
APP_DB_PASSWORD=placeholder-app-db-password

# --- Ory Kratos identity provider (Phase 2) -------------------------------
# DSN must match the Kratos role/password/db above. Internal network host.
KRATOS_DSN=postgres://kratos:placeholder-kratos-db-password@postgres:5432/kratos?sslmode=disable
# Externally reachable Kratos public URL used in verification/recovery links.
# In production this must be the public origin, never localhost.
KRATOS_PUBLIC_BASE_URL=https://capsulezero.app/
# SMTP courier: production uses Resend SMTP (host smtp.resend.com, username
# resend, password = Resend API key). Port is 2465 (implicit TLS), NOT 465:
# Hetzner Cloud blocks outbound 25/465 platform-wide; 587/2465/2587 are open
# (verified from the prod host 2026-07-03). URL-encode special characters.
KRATOS_SMTP_CONNECTION_URI=smtps://resend:replace-with-real-resend-api-key@smtp.resend.com:2465/
# Generate real secrets for the droplet. Kratos cookie secrets must be strong
# random strings; the xchacha20-poly1305 cipher secret must be exactly 32
# characters, for example:
#   openssl rand -base64 32
#   openssl rand -hex 16
# Kratos reads list-valued secrets from indexed env keys; compose requires them.
SECRETS_COOKIE_0=replace-with-real-kratos-cookie-secret-min32
SECRETS_CIPHER_0=change-this-32-char-cipher-key!!
# Google sign-in (spec 037) — leave unset/false to ship with Google OFF.
# To enable: create the OAuth client in Google Cloud Console (runbook
# docs_capsule_zero/project/devops/google-oauth-setup.md), then set all three
# values below. KRATOS_OIDC_PROVIDERS is a single-line JSON array; the
# client secret lives ONLY here (never in the repo).
#KRATOS_OIDC_ENABLED=true
#KRATOS_OIDC_PROVIDERS=[{"id":"google","provider":"google","label":"Google","client_id":"replace.apps.googleusercontent.com","client_secret":"replace-with-client-secret","mapper_url":"file:///etc/config/kratos/oidc.google.jsonnet","scope":["openid","email","profile"]}]

# --- Go API (Phase 2 auth slice) ------------------------------------------
CAPSULE_API_IMAGE=capsule-zero-api:local
GO_VERSION_API=1.25.13
# App database URL — uses the least-privilege APP_DB_* role (spec 034), not the
# POSTGRES_* superuser.
API_DATABASE_URL=postgres://capsule_app:placeholder-app-db-password@postgres:5432/capsule_zero?sslmode=disable
# Internal Kratos URLs (private network service names).
KRATOS_INTERNAL_PUBLIC_URL=http://kratos:4433
KRATOS_INTERNAL_ADMIN_URL=http://kratos:4434
# Published on loopback for the host nginx edge to proxy /api/* to.
API_HOST_BIND=127.0.0.1
# Kratos public on loopback: the edge proxies only the Google OIDC callback.
KRATOS_HOST_BIND=127.0.0.1
# Set true together with KRATOS_OIDC_* above so the API serves /api/auth/google/*.
#AUTH_GOOGLE_ENABLED=true

# --- Hetzner Object Storage (spec 040 runtime) ------------------------------
# Asset buckets are in project 15203114 / HEL. The runtime key lives in the
# dedicated bucketless project 15302873 and receives only the cross-project
# private-prefix actions in deploy/object-storage/private-assets-policy.template.json;
# it is explicitly denied on the public bucket. Never copy real key values into
# git, CI logs, or PR text.
OBJECT_STORAGE_ENDPOINT=https://hel1.your-objectstorage.com
OBJECT_STORAGE_REGION=hel1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-runtime-object-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-runtime-object-storage-secret-key
OBJECT_STORAGE_PRIVATE_BUCKET=capsulezero-prod-private-assets
OBJECT_STORAGE_PUBLIC_BUCKET=capsulezero-prod-public-catalog
OBJECT_STORAGE_PUBLIC_BASE_URL=https://capsulezero-prod-public-catalog.hel1.your-objectstorage.com
# Fail closed by default. Set true only after every documented activation gate.
OBJECT_STORAGE_UPLOADS_ENABLED=false

# --- Encrypted Postgres backups (Phase 5, separate project/key) -------------
# Bucket: project 15296835 / FSN, Object Lock enabled at creation. The writer key
# lives in dedicated bucketless project 15302925; its cross-project policy allows
# postgres/* writes and explicitly denies reads, deletes, listing, ACL mutation,
# and direct retention/legal-hold control. Backup code must also reject Object Lock
# headers on PutObject: Hetzner accepts those headers under the write grant. This
# provisioning does not permit plaintext backups or complete backup automation.
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_REGION=fsn1
BACKUP_S3_BUCKET=capsulezero-prod-backups
BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-object-storage-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-object-storage-secret-key
BACKUP_AGE_RECIPIENT=age1replacewithrealpublicrecipient

# --- Web frontend (/app) provider wiring ----------------------------------
# `api` is the real Go backend (auth/profile live; other domains read from mock
# fixtures until their slice migrates). The web container reaches the Go API
# server-side over the private network.
CAPSULE_PROVIDER_MODE=api
CAPSULE_API_BASE_URL=http://api:8080
# HMAC secret for the signed app session cookie. REPLACE in prod (32+ bytes).
SESSION_SIGNING_SECRET=placeholder-session-signing-secret-32-bytes-min
