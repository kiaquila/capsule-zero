# Copy to `.env` on a stage or production VM before running Docker Compose.
# Values below are runnable for local smoke checks only. Rotate every secret for
# any shared, staging, or production environment before the first startup.

COMPOSE_PROJECT_NAME=capsule-zero

# Traefik / Cloudflare ACME DNS-01
ACME_EMAIL=ops@capsulezero.app
CF_DNS_API_TOKEN=

# Capsule Zero web container
CAPSULE_WEB_IMAGE=capsule-zero-web:local
CAPSULE_RUNTIME_ENV_FILE=./deploy/runtime.env
CAPSULE_HOST_BIND=127.0.0.1
CAPSULE_HOST_PORT=3000
CAPSULE_CONTAINER_PORT=3000
NODE_VERSION=22-bookworm-slim

# Public URLs
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
API_EXTERNAL_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:3000
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:3000/en/auth,http://localhost:3000/en/auth

# Supabase gateway / dashboard / database ports
KONG_HOST_BIND=127.0.0.1
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_HOST_BIND=127.0.0.1
STUDIO_PORT=3001
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=54329
POOLER_HOST_BIND=127.0.0.1
POOLER_PROXY_PORT_TRANSACTION=6543

# Supabase database
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Supabase Auth / API keys. These demo keys match the demo JWT_SECRET below.
# Generate new JWT_SECRET, ANON_KEY, and SERVICE_ROLE_KEY for real environments.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SESSION_SIGNING_SECRET=replace-with-dedicated-app-session-signing-secret
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Supabase Studio
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-this-dashboard-password
STUDIO_DEFAULT_ORGANIZATION=Capsule Zero
STUDIO_DEFAULT_PROJECT=Capsule Zero Production
OPENAI_API_KEY=

# Internal Supabase service secrets
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
VAULT_ENC_KEY=0123456789abcdef0123456789abcdef
PG_META_CRYPTO_KEY=0123456789abcdef0123456789abcdef

# Supavisor
POOLER_TENANT_ID=capsule-zero-local
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# Supabase Auth
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_SENDER_NAME=Capsule Zero
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Supabase Storage / imgproxy
GLOBAL_S3_BUCKET=capsule-zero-storage
REGION=local
STORAGE_TENANT_ID=capsule-zero
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-s3-protocol-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-s3-protocol-secret
IMGPROXY_AUTO_WEBP=true

# Supabase Edge Runtime
FUNCTIONS_VERIFY_JWT=true

# PostgREST
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Real external providers. Leave blank locally; production health will stay
# degraded until the provider credentials/endpoints are supplied.
PHOTOROOM_API_KEY=
PHOTOROOM_API_URL=https://sdk.photoroom.com/v1/segment
REMOVE_BG_API_KEY=
MARKETPLACE_IMPORT_API_URL=
MARKETPLACE_IMPORT_API_KEY=
LAVA_API_URL=https://gate.lava.top/api/v3/invoice
LAVA_API_KEY=
LAVA_WEBHOOK_API_KEY=
LAVA_COINS_5_PRODUCT_ID=
LAVA_COINS_15_PRODUCT_ID=
LAVA_COINS_30_PRODUCT_ID=
EMBEDDING_PROVIDER=pgvector
