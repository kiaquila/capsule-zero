# Copy to `deploy/runtime.env` on the staging VM.
# Real secrets are supplied by the VM environment / secret manager, not by git.

NEXT_PUBLIC_APP_URL=https://stage.capsule-zero.example
CAPSULE_PROVIDER_MODE=supabase

SUPABASE_INTERNAL_URL=http://kong:8000
NEXT_PUBLIC_SUPABASE_URL=https://supabase.stage.capsule-zero.example
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-stage-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-stage-service-role-key

MOBILE_DEEP_LINK_SCHEME=capsulezero

PHOTOROOM_API_KEY=replace-with-stage-photoroom-key
PHOTOROOM_API_URL=https://sdk.photoroom.com/v1/segment
REMOVE_BG_API_KEY=
MARKETPLACE_IMPORT_API_URL=replace-with-stage-marketplace-import-url
MARKETPLACE_IMPORT_API_KEY=replace-with-stage-marketplace-import-key
LAVA_API_URL=https://gate.lava.top/api/v3/invoice
LAVA_API_KEY=replace-with-stage-lava-key
LAVA_WEBHOOK_API_KEY=replace-with-stage-lava-webhook-key
LAVA_COINS_5_PRODUCT_ID=replace-with-stage-lava-coins-5-product
LAVA_COINS_15_PRODUCT_ID=replace-with-stage-lava-coins-15-product
LAVA_COINS_30_PRODUCT_ID=replace-with-stage-lava-coins-30-product
EMBEDDING_PROVIDER=pgvector
