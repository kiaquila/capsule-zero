#!/usr/bin/env bash
set -euo pipefail

app_dir="/opt/capsule-zero"
compose_project="capsule-zero"
compose_file="docker-compose.yml"
env_file=".env"
state_dir="/var/lib/capsule-zero"
nginx_sync_marker="$state_dir/last-host-nginx-sync-sha"
host_tls_certificate="/etc/letsencrypt/live/capsulezero.app/fullchain.pem"
nginx_paths=(
  /etc/nginx/conf.d/00-capsule-zero.conf
  /etc/nginx/conf.d/00-cz-hardening.conf
  /etc/nginx/snippets/cz-request-guard.conf
  /etc/nginx/sites-available/00-default-deny.conf
  /etc/nginx/sites-available/capsulezero.app.conf
  /etc/nginx/sites-enabled/00-default-deny.conf
  /etc/nginx/sites-enabled/capsulezero.app.conf
  /etc/nginx/sites-enabled/default
)

usage() {
  echo "usage: capsule-zero-deploy <web-image-ref> <api-image-ref> <deploy-sha> <sync-host-nginx:true|false>" >&2
}

die() {
  echo "capsule-zero-deploy: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

if [ "$#" -ne 4 ]; then
  usage
  exit 64
fi

web_image_ref="$1"
api_image_ref="$2"
deploy_sha="$3"
sync_host_nginx="$4"

[ "$(id -u)" -eq 0 ] || die "must run as root via sudo"
[[ "$web_image_ref" =~ ^ghcr\.io/kiaquila/capsule-zero-web:sha-[0-9a-f]{40}$ ]] \
  || die "web image ref must be ghcr.io/kiaquila/capsule-zero-web:sha-<40 lowercase hex>"
[[ "$api_image_ref" =~ ^ghcr\.io/kiaquila/capsule-zero-api:sha-[0-9a-f]{40}$ ]] \
  || die "api image ref must be ghcr.io/kiaquila/capsule-zero-api:sha-<40 lowercase hex>"
[[ "$deploy_sha" =~ ^[0-9a-f]{40}$ ]] || die "deploy SHA must be 40 lowercase hex characters"
[[ "$sync_host_nginx" =~ ^(true|false)$ ]] || die "sync-host-nginx must be true or false"

require_cmd curl
require_cmd docker
require_cmd git
require_cmd cat
require_cmd cp
require_cmd dirname
require_cmd grep
require_cmd install
require_cmd ln
require_cmd mkdir
require_cmd mktemp
require_cmd nginx
require_cmd openssl
require_cmd rm
require_cmd systemctl

[ -d "$app_dir/.git" ] || die "$app_dir is not a git checkout"
[ -f "$app_dir/$env_file" ] || die "$app_dir/$env_file is missing (operator setup incomplete)"
cd "$app_dir"

git fetch --prune origin
git cat-file -e "${deploy_sha}^{commit}" || die "deploy SHA is not present in the checkout"
git merge-base --is-ancestor "$deploy_sha" origin/main \
  || die "deploy SHA must be reachable from origin/main"

install -d -m 755 "$state_dir"
host_nginx_changed=false
if [ "$sync_host_nginx" = "true" ]; then
  last_nginx_sync_sha="$(cat "$nginx_sync_marker" 2>/dev/null || true)"
  if [ -z "$last_nginx_sync_sha" ] \
    || [[ ! "$last_nginx_sync_sha" =~ ^[0-9a-f]{40}$ ]] \
    || ! git cat-file -e "${last_nginx_sync_sha}^{commit}" 2>/dev/null; then
    host_nginx_changed=true
  elif [ -n "$(git diff --name-only "$last_nginx_sync_sha" "$deploy_sha" -- infra/nginx-host/)" ]; then
    host_nginx_changed=true
  fi
else
  echo "host nginx config sync skipped for image rollback"
fi

git checkout --force "$deploy_sha"

export CAPSULE_WEB_IMAGE="$web_image_ref"
export CAPSULE_API_IMAGE="$api_image_ref"
compose=(docker compose --env-file "$env_file" -p "$compose_project" -f "$compose_file")

# Images are always pulled from GHCR, never built on the server: a build here
# would compete with the running services for RAM/CPU and bypass CI provenance.
"${compose[@]}" pull web api
"${compose[@]}" up -d --no-build --remove-orphans

wait_healthy() {
  local service="$1" tries="$2" cid status
  cid="$("${compose[@]}" ps -q "$service")"
  [ -n "$cid" ] || die "$service container was not created"
  status="starting"
  for _ in $(seq 1 "$tries"); do
    status="$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null || echo starting)"
    [ "$status" = "healthy" ] && return 0
    sleep 5
  done
  echo "$service did not become healthy (status=$status)" >&2
  "${compose[@]}" logs --tail=80 "$service" >&2
  return 1
}

# First boot runs Postgres init + Kratos migrations before api/web can pass
# healthchecks, so the waits are generous (5 s steps).
wait_healthy api 60
wait_healthy web 60

backup_nginx_config() {
  backup_dir="$(mktemp -d)"
  present_file="$backup_dir/present"
  absent_file="$backup_dir/absent"
  : > "$present_file"
  : > "$absent_file"

  local path safe_path dest
  for path in "${nginx_paths[@]}"; do
    safe_path="${path#/}"
    dest="$backup_dir/$safe_path"
    if [ -e "$path" ] || [ -L "$path" ]; then
      mkdir -p "$(dirname "$dest")"
      cp -a "$path" "$dest"
      printf '%s\n' "$path" >> "$present_file"
    else
      printf '%s\n' "$path" >> "$absent_file"
    fi
  done
}

restore_nginx_config() {
  local path safe_path source_path
  for path in "${nginx_paths[@]}"; do
    safe_path="${path#/}"
    source_path="$backup_dir/$safe_path"
    rm -rf "$path"
    if grep -Fxq "$path" "$present_file"; then
      mkdir -p "$(dirname "$path")"
      cp -a "$source_path" "$path"
    fi
  done
  nginx -t
  systemctl reload nginx
}

verify_host_certificate() {
  local hostname
  [ -r "$host_tls_certificate" ] || {
    echo "host TLS certificate is missing: $host_tls_certificate" >&2
    return 1
  }
  for hostname in capsulezero.app www.capsulezero.app; do
    if ! openssl x509 -in "$host_tls_certificate" -noout \
      -checkhost "$hostname" >/dev/null 2>&1; then
      echo "host TLS certificate does not cover $hostname" >&2
      return 1
    fi
  done
}

apply_host_nginx_config() {
  verify_host_certificate || return
  install -m 644 infra/nginx-host/00-capsule-zero.conf /etc/nginx/conf.d/00-capsule-zero.conf || return
  install -m 644 infra/nginx-host/00-cz-hardening.conf /etc/nginx/conf.d/00-cz-hardening.conf || return
  install -m 644 infra/nginx-host/cz-request-guard.conf /etc/nginx/snippets/cz-request-guard.conf || return
  install -m 644 infra/nginx-host/00-default-deny.conf /etc/nginx/sites-available/00-default-deny.conf || return
  install -m 644 infra/nginx-host/capsulezero.app.conf /etc/nginx/sites-available/capsulezero.app.conf || return
  ln -sf /etc/nginx/sites-available/00-default-deny.conf /etc/nginx/sites-enabled/ || return
  ln -sf /etc/nginx/sites-available/capsulezero.app.conf /etc/nginx/sites-enabled/ || return
  rm -f /etc/nginx/sites-enabled/default || return
  nginx -t || return
  systemctl reload nginx || return
}

smoke_prod_edge() {
  # Smoke the web on its loopback port, then end-to-end through the host nginx.
  # --resolve keeps the request on the server while preserving hostname/SNI/cert
  # validation. /api/health proves the whole provider chain: nginx -> Go API ->
  # Postgres/Kratos.
  curl -fsS -o /dev/null http://127.0.0.1:3000/en || return
  curl -fsS -o /dev/null --resolve capsulezero.app:443:127.0.0.1 https://capsulezero.app/en || return
  curl -fsS -o /dev/null --resolve capsulezero.app:443:127.0.0.1 https://capsulezero.app/api/health || return
}

if [ "$host_nginx_changed" = "true" ]; then
  echo "host nginx config changed; installing and reloading"
  backup_nginx_config
  if ! apply_host_nginx_config || ! smoke_prod_edge; then
    echo "host nginx update or smoke failed; restoring previous config" >&2
    if ! restore_nginx_config; then
      echo "failed to restore previous host nginx config; manual intervention required" >&2
    fi
    rm -rf "$backup_dir"
    exit 1
  fi
  rm -rf "$backup_dir"
else
  echo "host nginx config unchanged"
  smoke_prod_edge
fi

echo "smoke ok"
"${compose[@]}" ps

if [ "$sync_host_nginx" = "true" ]; then
  printf '%s\n' "$deploy_sha" > "$nginx_sync_marker"
fi
