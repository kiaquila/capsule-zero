# macOS
.DS_Store
**/.DS_Store

# env files
.env*
deploy/*.env
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example
!deploy/*.env.example
# Committed dev-compose env: throwaway local-dev credentials only (see docker-compose.dev.yml header)
!deploy/compose.dev.env

# IDE
.idea/
.vscode/

# logs
*.log

# runtime validation outputs
.runtime/

# local agent/tool state
.omc/
.omx/
.playwright-mcp/
.codex/
.claude/

# dependencies
/node_modules/

# supabase CLI local scratch (legacy stack — kept ignored so the CLI
# does not pollute git status while the legacy code is retired)
supabase/.branches/
supabase/.temp/

# local mkcert dev certs (generated by scripts/local-certs.mjs)
/infra/dev-certs/
